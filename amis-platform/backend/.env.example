# ============================================================================
# AMIS Backend - Variáveis de Ambiente da API
# ----------------------------------------------------------------------------
# Copie para `.env` e preencha. NUNCA commitar o `.env` real.
# A validação estrita destas variáveis acontece em src/config/env.ts (Zod):
# se qualquer variável obrigatória estiver ausente/ inválida, a API NÃO sobe.
# ============================================================================

# Ambiente: development | test | production
NODE_ENV=development
PORT=3333

# --- Banco de Dados (deve bater com o docker-compose.yml da raiz) ---
# Formato: postgresql://USER:PASSWORD@HOST:PORT/DB?schema=public
DATABASE_URL="postgresql://amis_admin:troque_esta_senha_forte@localhost:5432/amis_db?schema=public"

# --- Autenticação JWT ---
# Use um segredo longo e aleatório (>= 32 chars). Ex.: `openssl rand -hex 32`
JWT_SECRET="coloque_aqui_um_segredo_aleatorio_de_no_minimo_32_caracteres"
JWT_EXPIRES_IN="1d"

# --- Stripe (Pagamentos) ---
# Use as chaves de TESTE (prefixo sk_test_) em desenvolvimento.
# Cole a chave real apenas no seu arquivo .env (que NÃO é versionado).
STRIPE_SECRET_KEY="COLE_AQUI_SUA_CHAVE_SECRETA_DE_TESTE_STRIPE"
STRIPE_WEBHOOK_SECRET="COLE_AQUI_SEU_WEBHOOK_SECRET_STRIPE"

# --- CORS ---
# Lista de origens permitidas separadas por vírgula.
CORS_ORIGINS="http://localhost:8081,http://localhost:19006"
