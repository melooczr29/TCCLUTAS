# Copie este arquivo para .env e troque os valores marcados com TROQUE.
# O arquivo .env nunca vai para o Git.

# Banco de dados
POSTGRES_DB=kyudan
POSTGRES_USER=kyudan
POSTGRES_PASSWORD=TROQUE_senha_do_banco

# API
JWT_SECRET=TROQUE_por_um_texto_longo_e_aleatorio
JWT_EXPIRES_IN=8h

# Administrador supremo (criado na primeira subida da API)
SUPERADMIN_NAME=Antonio Cesar
SUPERADMIN_EMAIL=TROQUE_seu_email
SUPERADMIN_PASSWORD=TROQUE_sua_senha

# Dados de demonstracao (academia, turma, alunos). Use false em producao.
SEED_DEMO=true
DEMO_PASSWORD=TROQUE_senha_dos_usuarios_demo

# Somente para rodar a API fora do Docker (npm run dev). Use a mesma senha do banco.
# DATABASE_URL=postgres://kyudan:TROQUE_senha_do_banco@localhost:5432/kyudan

# Portas no seu computador. Troque se alguma ja estiver em uso por outro projeto.
WEB_PORT=8090
API_PORT=3010
DB_PORT=5433
